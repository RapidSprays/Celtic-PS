# Proprietary client material never enters git
*.dll
*.dylib
*.bundle
*.assets
*.resS
*.app/
*.so
*.exe
decompiled/
snapshots/
client/
level[0-9]*
globalgamemanagers*

# Captures, databases, secrets
*.pcap
*.pcapng
*.db
*.sqlite
*.sqlite3
.env
.env.*
google-services*.json

# Build output
bin/
obj/
*.user
.vs/
.idea/
TestResults/
logs/
.DS_Store

# Personal Claude Code settings
.claude/settings.local.json
__pycache__/

# Local working files: the tool's backups and content generated from the client (scripts/gen-quest-exclusions.py)
server/content/.backup/
server/content/quest-exclusions.json
